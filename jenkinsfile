pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'ls -la'
            }
        }
        stage('Build Image') {
            steps {
                sh '''
                    TAG=$(echo $GIT_COMMIT | cut -c1-7)
                    docker build -t arbor-web:$TAG .
                    docker images arbor-web
                '''
            }
        }
    }
}
